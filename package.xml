<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>open_robot_control</name>
  <version>1.0.0</version>
  <description>OpenRobotControl - a general-purpose, open-source Qt6 desktop interface for robot control, telemetry, and simulation with optional ROS2 integration.</description>
  <maintainer email="umerghafoor.lab@gmail.com">OpenRobotControl Contributors</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
