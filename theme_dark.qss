/* ============================================================
   OpenRobotControl — Dark Theme (Indigo)
   Control-room look, indigo accent.
   ============================================================ */


/* ── 0. Design Tokens (via comments for reference) ───────────
   --bg-base:        #0F172A   slate-900
   --bg-window:      #111827   gray-900
   --bg-surface:     #1E293B   slate-800
   --bg-surface-2:   #1F2937   gray-800
   --bg-hover:       #273344
   --primary-700:    #6366F1   primary action (lifted for dark)
   --primary-600:    #818CF8   hover
   --primary-500:    #A5B4FC   bright accent
   --primary-800:    #4F46E5   pressed
   --primary-900:    #3730A3   pressed-dark
   --primary-tint:   #1E1B4B   selection / subtle tint
   --red:            #EF4444   emergency
   --amber:          #F59E0B   stop / warning
   --text-primary:   #F3F4F6
   --text-secondary: #9CA3AF
   --text-muted:     #6B7280
   --border:         #334155
   --border-strong:  #475569
   ──────────────────────────────────────────────────────────── */


/* ── 1. Base ──────────────────────────────────────────────── */

* {
    outline: none;
}

QWidget {
    background-color: #0F172A;
    color: #F3F4F6;
    font-family: "Inter", "Segoe UI", "Ubuntu", sans-serif;
    font-size: 13px;
    font-weight: 400;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}

QMainWindow {
    background-color: #0B1220;
}

#mainCentralWidget {
    background-color: #060B17;
}


/* ── 2. Menu Bar ──────────────────────────────────────────── */

QMenuBar {
    background-color: #111827;
    color: #F3F4F6;
    border-bottom: 2px solid #6366F1;
    min-height: 38px;
    padding: 0;
    font-size: 13px;
    font-weight: 400;
}
QMenuBar::item {
    background: transparent;
    padding: 7px 14px;
    border-radius: 4px;
    margin: 2px 2px;
}
QMenuBar::item:selected {
    background-color: #1E1B4B;
    color: #C7D2FE;
}
QMenuBar::item:pressed {
    background-color: #3730A3;
    color: #FFFFFF;
}

QLabel#appBarBrandLabel {
    color: #F3F4F6;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
    border: none;
    padding: 0 14px;
    letter-spacing: -0.2px;
}

QWidget#appBarBadgeContainer {
    background: transparent;
    border: none;
    padding: 0 10px;
}


/* ── 3. Menus ─────────────────────────────────────────────── */

QMenu {
    background-color: #1E293B;
    color: #F3F4F6;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
    font-size: 13px;
}
QMenu::item {
    padding: 7px 18px 7px 14px;
    border-radius: 5px;
    margin: 1px 2px;
}
QMenu::item:selected {
    background-color: #3730A3;
    color: #FFFFFF;
}
QMenu::item:disabled {
    color: #6B7280;
}
QMenu::separator {
    height: 1px;
    background-color: #334155;
    margin: 4px 8px;
}
QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 4px;
}


/* ── 4. Toolbar ───────────────────────────────────────────── */

QToolBar {
    background-color: #111827;
    border: none;
    border-bottom: 1px solid #1F2937;
    spacing: 4px;
    padding: 4px 10px;
}
QToolBar::separator {
    width: 1px;
    background-color: #1F2937;
    margin: 6px 4px;
}

QToolBar QToolButton {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}
QToolBar QToolButton:hover {
    background-color: #6366F1;
}
QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background-color: #3730A3;
}
QToolBar QToolButton:disabled {
    background-color: #1F2937;
    color: #6B7280;
}

QToolButton#connectButton {
    min-width: 90px;
    min-height: 30px;
}


/* ── 5. Dock Widgets ──────────────────────────────────────── */

QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    border: 1px solid #1F2937;
}

QDockWidget > QWidget {
    background-color: #111827;
}

/* Dock title bar */
QWidget#dockTitleBar {
    background-color: #3730A3;
    border-bottom: 2px solid #1E1B4B;
    min-height: 34px;
    max-height: 34px;
}

QLabel#dockGripLabel {
    color: rgba(255, 255, 255, 0.5);
    font-size: 10px;
    background: transparent;
    border: none;
    padding: 0 4px;
}

QLabel#dockTitleLabel {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 600;
    background: transparent;
    border: none;
    letter-spacing: 0.4px;
}

QToolButton#dockFloatButton,
QToolButton#dockCloseButton {
    background-color: transparent;
    color: rgba(255, 255, 255, 0.7);
    border: none;
    border-radius: 0;
    min-width: 34px;
    min-height: 34px;
    max-width: 34px;
    max-height: 34px;
    font-size: 13px;
    padding: 0;
}
QToolButton#dockFloatButton:hover,
QToolButton#dockCloseButton:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
}
QToolButton#dockFloatButton:pressed,
QToolButton#dockCloseButton:pressed {
    background-color: rgba(255, 255, 255, 0.22);
    color: #FFFFFF;
}


/* ── 6. Status Bar ────────────────────────────────────────── */

QStatusBar {
    background-color: #111827;
    color: #9CA3AF;
    border-top: 1px solid #1F2937;
    font-size: 12px;
    padding: 0 8px;
}
QStatusBar::item {
    border: none;
}


/* ── 7. Buttons ───────────────────────────────────────────── */

QPushButton {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 5px 14px;
    font-size: 13px;
    font-weight: 500;
    min-height: 26px;
}
QPushButton:hover {
    background-color: #6366F1;
}
QPushButton:pressed {
    background-color: #3730A3;
}
QPushButton:disabled {
    background-color: #1F2937;
    color: #6B7280;
}
QPushButton:focus {
    outline: none;
    border: 2px solid #A5B4FC;
    padding: 5px 16px;
}
QPushButton:checked {
    background-color: #3730A3;
    border: none;
}
QPushButton:checked:hover {
    background-color: #4F46E5;
}

/* 3D model toolbar — compact button strip */
QWidget#modelToolbar QPushButton {
    min-height: 22px;
    max-height: 26px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 500;
    border-radius: 5px;
}
QWidget#modelToolbar QPushButton#modelZoomBtn {
    padding: 2px 6px;
    min-width: 22px;
    max-width: 26px;
}

/* Stop — amber outline */
QPushButton#stopButton {
    color: #FCD34D;
    border: 2px solid #F59E0B;
    background-color: #1F1503;
    border-radius: 6px;
    font-weight: 700;
    padding: 8px 16px;
    min-height: 36px;
    font-size: 12px;
    letter-spacing: 0.5px;
}
QPushButton#stopButton:hover {
    background-color: #2A1D04;
    border-color: #FBBF24;
    color: #FEF3C7;
}
QPushButton#stopButton:pressed {
    background-color: #3A2706;
}

/* Emergency Stop — filled red */
QPushButton#emergencyStopButton {
    background-color: #DC2626;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 8px 16px;
    min-height: 36px;
    font-size: 12px;
}
QPushButton#emergencyStopButton:hover {
    background-color: #EF4444;
}
QPushButton#emergencyStopButton:pressed {
    background-color: #B91C1C;
}

/* Sidebar D-pad and all control buttons */
SidebarWidget QPushButton {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 4px;
    font-size: 18px;
    font-weight: 400;
}
SidebarWidget QPushButton:hover {
    background-color: #6366F1;
}
SidebarWidget QPushButton:pressed {
    background-color: #3730A3;
}
SidebarWidget QPushButton:disabled {
    background-color: #1F2937;
    color: #4B5563;
}

/* Spin / text buttons in sidebar — normal height, wider */
SidebarWidget QPushButton#spinLeftButton,
SidebarWidget QPushButton#spinRightButton {
    font-size: 13px;
    min-height: 34px;
    border-radius: 6px;
}


/* ── 8. Group Boxes ───────────────────────────────────────── */

QGroupBox {
    background-color: #1E293B;
    border: 1px solid #1F2937;
    border-left: 3px solid #6366F1;
    border-radius: 0;
    margin-top: 18px;
    padding: 8px 6px 6px 6px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    top: -1px;
    padding: 0 5px;
    color: #A5B4FC;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    background-color: #1E293B;
}


/* ── 9. Sliders ───────────────────────────────────────────── */

QSlider::groove:horizontal {
    background-color: #1F2937;
    border: none;
    height: 5px;
    border-radius: 2px;
}
QSlider::groove:horizontal:disabled {
    background-color: #111827;
}
QSlider::handle:horizontal {
    background-color: #6366F1;
    border: 2px solid #1E293B;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background-color: #818CF8;
}
QSlider::handle:horizontal:pressed {
    background-color: #4F46E5;
}
QSlider::handle:horizontal:disabled {
    background-color: #374151;
    border-color: #111827;
}
QSlider::sub-page:horizontal {
    background-color: #6366F1;
    border-radius: 2px;
}
QSlider::sub-page:horizontal:disabled {
    background-color: #374151;
}


/* ── 10. Scroll Bars ──────────────────────────────────────── */

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #374151;
    border-radius: 4px;
    min-height: 28px;
    min-width: 28px;
}
QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #4B5563;
}
QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background-color: #6366F1;
}
QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
}

QScrollArea {
    background-color: transparent;
    border: none;
}


/* ── 11. Tab Bar ──────────────────────────────────────────── */

QTabWidget::pane {
    border: 1px solid #1F2937;
    border-top: none;
    background-color: #1E293B;
    border-radius: 0 0 4px 4px;
}
QTabBar {
    background-color: #111827;
    border: none;
}
QTabBar::tab {
    background-color: transparent;
    color: #9CA3AF;
    padding: 7px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
    font-weight: 500;
    min-width: 60px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    color: #C7D2FE;
    font-weight: 600;
    border-bottom: 2px solid #6366F1;
}
QTabBar::tab:hover:!selected {
    color: #E5E7EB;
    border-bottom: 2px solid #3730A3;
}


/* ── 12. Status Badges ────────────────────────────────────── */

QWidget#statusBadge {
    background-color: #1F2937;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 2px 10px;
    min-height: 24px;
}
QWidget#statusBadge QLabel {
    color: #D1D5DB;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
    border: none;
    letter-spacing: 0.2px;
}


/* ── 13. Telemetry Cells (SensorDataWidget) ───────────────── */

QFrame#telemetryCell {
    background-color: #1E293B;
    border: 1px solid #1F2937;
    border-top: 3px solid #6366F1;
    border-radius: 0;
}
QLabel#cellNameLabel {
    color: #9CA3AF;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}
QLabel#cellValueLabel {
    color: #F3F4F6;
    font-family: "JetBrains Mono", "Fira Code", "Courier New", monospace;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.5px;
}
QLabel#cellUnitLabel {
    color: #6B7280;
    font-size: 10px;
    font-weight: 500;
}


/* ── 14. Progress Bars ────────────────────────────────────── */

QProgressBar {
    background-color: #1F2937;
    border: none;
    border-radius: 2px;
    max-height: 4px;
    min-height: 4px;
}
QProgressBar::chunk {
    background-color: #6366F1;
    border-radius: 2px;
}


/* ── 15. Radio / Check Buttons ───────────────────────────── */

QRadioButton {
    color: #F3F4F6;
    font-size: 13px;
    spacing: 7px;
}
QRadioButton::indicator {
    width: 17px;
    height: 17px;
    border-radius: 8px;
    border: 2px solid #475569;
    background-color: #1E293B;
}
QRadioButton::indicator:checked {
    border-color: #6366F1;
    background-color: #6366F1;
}
QRadioButton::indicator:hover {
    border-color: #818CF8;
}
QRadioButton::indicator:disabled {
    border-color: #334155;
    background-color: #111827;
}

QCheckBox {
    color: #F3F4F6;
    font-size: 13px;
    spacing: 7px;
}
QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 3px;
    border: 2px solid #475569;
    background-color: #1E293B;
}
QCheckBox::indicator:checked {
    border-color: #6366F1;
    background-color: #6366F1;
}
QCheckBox::indicator:hover {
    border-color: #818CF8;
}
QCheckBox::indicator:disabled {
    border-color: #334155;
    background-color: #111827;
}


/* ── 16. Text Inputs ──────────────────────────────────────── */

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #1E293B;
    color: #F3F4F6;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}
QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #6366F1;
    border-width: 2px;
    padding: 4px 9px;
}
QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    background-color: #111827;
    color: #6B7280;
    border-color: #1F2937;
}


/* ── 17. Spin Boxes ───────────────────────────────────────── */

QSpinBox,
QDoubleSpinBox {
    background-color: #1E293B;
    color: #F3F4F6;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 13px;
}
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #6366F1;
    border-width: 2px;
}
QSpinBox::up-button,
QDoubleSpinBox::up-button {
    border: none;
    width: 18px;
    border-radius: 0 6px 0 0;
}
QSpinBox::down-button,
QDoubleSpinBox::down-button {
    border: none;
    width: 18px;
    border-radius: 0 0 6px 0;
}
QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #1E1B4B;
}


/* ── 18. Combo Box ────────────────────────────────────────── */

QComboBox {
    background-color: #1E293B;
    color: #F3F4F6;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    min-height: 28px;
}
QComboBox:hover {
    border-color: #6366F1;
}
QComboBox:focus {
    border-color: #6366F1;
    border-width: 2px;
    padding: 4px 9px;
}
QComboBox::drop-down {
    border: none;
    width: 28px;
    border-radius: 0 6px 6px 0;
}
QComboBox::down-arrow {
    width: 10px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background-color: #1E293B;
    color: #F3F4F6;
    border: 1px solid #334155;
    border-radius: 6px;
    selection-background-color: #3730A3;
    selection-color: #FFFFFF;
    outline: none;
}


/* ── 19. List / Tree / Table Views ───────────────────────── */

QListView,
QTreeView,
QTableView {
    background-color: #1E293B;
    alternate-background-color: #1F2937;
    color: #F3F4F6;
    border: 1px solid #1F2937;
    border-radius: 4px;
    gridline-color: #1F2937;
    outline: none;
}
QListView::item,
QTreeView::item,
QTableView::item {
    padding: 4px 8px;
    min-height: 28px;
}
QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background-color: #3730A3;
    color: #FFFFFF;
}
QListView::item:hover,
QTreeView::item:hover,
QTableView::item:hover {
    background-color: #273344;
}
QHeaderView::section {
    background-color: #111827;
    color: #D1D5DB;
    border: none;
    border-right: 1px solid #1F2937;
    border-bottom: 2px solid #6366F1;
    padding: 6px 10px;
    font-weight: 600;
    font-size: 12px;
}
QHeaderView::section:hover {
    background-color: #1E1B4B;
}


/* ── 20. Misc ─────────────────────────────────────────────── */

QFrame {
    background: transparent;
    border: none;
}

QSplitter::handle {
    background-color: #1F2937;
    width: 2px;
    height: 2px;
}
QSplitter::handle:hover {
    background-color: #6366F1;
}

QDialog {
    background-color: #0F172A;
}
QMessageBox {
    background-color: #1E293B;
    border: 1px solid #1F2937;
}
QMessageBox QLabel {
    color: #F3F4F6;
    font-size: 13px;
    background: transparent;
}
QMessageBox QPushButton {
    min-width: 80px;
}

QToolTip {
    background-color: #F3F4F6;
    color: #111827;
    border: none;
    border-radius: 5px;
    font-size: 12px;
    padding: 5px 10px;
}

QLabel {
    background: transparent;
}

/* ── 21. Navbar Connect Button ────────────────────────────── */

QToolButton#connectButton {
    background-color: #4F46E5;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: 600;
    min-height: 26px;
    min-width: 80px;
}
QToolButton#connectButton:hover {
    background-color: #6366F1;
}
QToolButton#connectButton:pressed {
    background-color: #3730A3;
}
QToolButton#connectButton:checked {
    background-color: #3730A3;
    color: #C7D2FE;
}
QToolButton#connectButton:checked:hover {
    background-color: #DC2626;
    color: #FFFFFF;
}


/* ── 22. Video Stream Header Bar ──────────────────────────── */

QWidget#videoHeaderBar {
    background-color: #111827;
    border-bottom: 1px solid #1F2937;
}

QPushButton#videoZoomBtn {
    background-color: #1E293B;
    color: #D1D5DB;
    border: 1px solid #334155;
    border-radius: 5px;
    font-size: 14px;
    font-weight: 600;
    min-height: 0;
    padding: 0;
}
QPushButton#videoZoomBtn:hover {
    background-color: #1E1B4B;
    border-color: #6366F1;
    color: #C7D2FE;
}
QPushButton#videoZoomBtn:pressed {
    background-color: #3730A3;
    color: #FFFFFF;
}

QTabBar#streamTabBar {
    background-color: #111827;
    border: none;
}
QTabBar#streamTabBar::tab {
    background-color: #111827;
    color: #9CA3AF;
    padding: 7px 22px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
    font-weight: 500;
    min-width: 80px;
}
QTabBar#streamTabBar::tab:selected {
    color: #C7D2FE;
    font-weight: 700;
    border-bottom: 2px solid #6366F1;
}
QTabBar#streamTabBar::tab:hover:!selected {
    color: #E5E7EB;
    background-color: #1E293B;
    border-bottom: 2px solid #334155;
}


/* ── Telemetry Cell — position variant (cyan accent) ─────── */

QFrame#telemetryCellAlt {
    background-color: #1E293B;
    border: 1px solid #1F2937;
    border-top: 3px solid #22D3EE;
    border-radius: 0;
}
QFrame#telemetryCellAlt QProgressBar::chunk {
    background-color: #22D3EE;
    border-radius: 2px;
}


/* ── Current Detection Widget ─────────────────────────────── */

QLabel#detectionCountBadge {
    background-color: #4F46E5;
    color: #FFFFFF;
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 16px;
    font-weight: 700;
    border-radius: 18px;
}

QLabel#detectionCountLabel {
    color: #9CA3AF;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.3px;
    line-height: 1.4;
    background: transparent;
}

QLabel#detectionTimestamp {
    color: #6B7280;
    font-size: 11px;
    font-family: "JetBrains Mono", "Fira Code", monospace;
    background: transparent;
}

QFrame#detectionClassCard {
    background-color: #1E1B4B;
    border: 1px solid #3730A3;
    border-left: 4px solid #6366F1;
    border-radius: 0;
}

QLabel#detectionCardLabel {
    color: #9CA3AF;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.2px;
    background: transparent;
}

QLabel#detectionClassName {
    color: #F3F4F6;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.3px;
    background: transparent;
}

QProgressBar#detectionConfBar {
    background-color: #1F2937;
    border: none;
    border-radius: 4px;
    max-height: 8px;
    min-height: 8px;
}
QProgressBar#detectionConfBar::chunk {
    background-color: #6366F1;
    border-radius: 4px;
}

QLabel#detectionConfValue {
    color: #F3F4F6;
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

QFrame#detectionDetailRow {
    background-color: #111827;
    border: 1px solid #1F2937;
    border-radius: 0;
}

QLabel#detectionFieldLabel {
    color: #6B7280;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    background: transparent;
}

QLabel#detectionDetailValue {
    color: #D1D5DB;
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}


/* KPI stat card */
QFrame#summaryStatCard {
    background-color: #1E293B;
    border: 1px solid #1F2937;
    border-top: 3px solid #6366F1;
    border-radius: 0;
}

QLabel#summaryStatValue {
    color: #F3F4F6;
    font-family: "JetBrains Mono", "Fira Code", "Courier New", monospace;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.5px;
    background: transparent;
}

QLabel#summaryStatLabel {
    color: #9CA3AF;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
    line-height: 1.3;
}

QFrame#summaryTopClass {
    background-color: #1E1B4B;
    border: 1px solid #3730A3;
    border-left: 4px solid #6366F1;
    border-radius: 0;
}

QLabel#summaryTopIcon {
    color: #FFFFFF;
    background-color: #4F46E5;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 2px 5px;
    border-radius: 3px;
}

QLabel#summaryTopLabel {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
    background: transparent;
}

QLabel#summaryTopClassName {
    color: #F3F4F6;
    font-family: "JetBrains Mono", "Fira Code", "Courier New", monospace;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

/* ── Detection Panel Widget (merged panel) ────────────────────── */

QFrame#panelDivider {
    background-color: #1F2937;
    border: none;
    margin: 2px 0;
}

QFrame#panelStatCard {
    background-color: #1E293B;
    border: 1px solid #1F2937;
    border-top: 2px solid #6366F1;
    border-radius: 0;
}

QLabel#panelStatValue {
    color: #F3F4F6;
    font-family: "JetBrains Mono", "Fira Code", "Courier New", monospace;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.3px;
    background: transparent;
}

QLabel#panelStatLabel {
    color: #9CA3AF;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background: transparent;
    line-height: 1.2;
}

/* end of theme_dark.qss */
